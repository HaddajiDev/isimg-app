<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Development runs the backend over plain HTTP on the
  emulator host (10.0.2.2) or a LAN IP, which Android 9+ blocks by default.

  Release builds deliberately do NOT get this file, so they stay
  cleartext-blocked and require an HTTPS backend.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
